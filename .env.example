# Copy to .env.local for local dev, or pass as --build-arg to Docker for production
VITE_SF_BASE_URL=https://your-sf-instance.salesforce.com
VITE_SF_CLIENT_ID=your_connected_app_client_id
VITE_SF_WEBSTORE_ID=your_webstore_id
# Set to true to use MSW mock data instead of real Salesforce APIs
VITE_USE_MOCKS=false
